# Copy to .env and fill in. NEVER commit your real token.
# Get a token from @BotFather on Telegram.
BOT_TOKEN=
# Path to the SQLite database file
DATABASE_PATH=data/schedule.db
# IANA timezone used for "today", "next class" and reminders (e.g. Europe/Moscow, UTC)
TIMEZONE=Europe/Moscow
# First day of the semester (YYYY-MM-DD). The week containing this date is week 1 (odd).
# If empty, the most recent 1 September is used.
SEMESTER_START=2026-09-01
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
